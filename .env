# ===================================================
# PYECSO Environment Variables Configuration
# ===================================================

# HesabPay Payment Gateway API Key (Afghanistan & Global Donations)
# Obtain from your HesabPay merchant dashboard (https://hesab.com)
HESABPAY_API_KEY=

# Lovable / AI Assistant API Key
# Used for server-side AI auto-translations and applicant notifications
LOVABLE_API_KEY=

# Google OAuth Client ID (Sign-in with Google)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=

# PYECSO Backend Bridge API Base URL (Optional, defaults to https://pyecso.org.af/api)
VITE_PYECSO_API_BASE_URL=

# Supabase Project Configuration (Optional)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
