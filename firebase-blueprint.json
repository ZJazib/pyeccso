{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with display info, email, and authentication state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 256 },
        "fullName": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "avatarUrl": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email", "createdAt"]
    },
    "UserRole": {
      "title": "UserRole",
      "description": "Role-based access permission mapping for user IDs.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": {
          "type": "string",
          "enum": [
            "super_admin",
            "admin",
            "content_manager",
            "editor",
            "media_manager",
            "learn_manager",
            "teacher",
            "student",
            "hr_manager",
            "finance_manager",
            "project_manager",
            "communications",
            "viewer"
          ]
        },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "role", "createdAt"]
    },
    "ContentItem": {
      "title": "ContentItem",
      "description": "Multilingual CMS content entity including programs, projects, news, events, and static pages.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "maxLength": 64 },
        "slug": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "position": { "type": "number" },
        "coverUrl": { "type": "string", "maxLength": 1024 },
        "data": { "type": "object" },
        "publishedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "createdBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "type", "status", "createdAt", "updatedAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Public contact form submission and inquiry message.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "subject": { "type": "string", "maxLength": 256 },
        "message": { "type": "string", "maxLength": 5000 },
        "province": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["new", "read", "replied", "archived", "spam"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "fullName", "email", "message", "status", "createdAt"]
    },
    "Application": {
      "title": "Application",
      "description": "Job, volunteer, internship, or educational program application submission.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "kind": { "type": "string", "enum": ["training", "job", "volunteer", "internship"] },
        "referenceId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "province": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["new", "pending", "reviewing", "shortlisted", "accepted", "rejected", "waitlist"] },
        "data": { "type": "object" },
        "notes": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "kind", "fullName", "email", "status", "createdAt", "updatedAt"]
    },
    "SiteSetting": {
      "title": "SiteSetting",
      "description": "Global configuration document for organization settings, HesabPay, and metadata.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "maxLength": 128 },
        "value": { "type": "object" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["key", "value", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable system and mutation audit trail.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorId": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 256 },
        "action": { "type": "string", "maxLength": 32 },
        "targetTable": { "type": "string", "maxLength": 64 },
        "entityId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "action", "targetTable", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles indexed by UID"
    },
    "/user_roles/{userId}": {
      "schema": { "$ref": "#/entities/UserRole" },
      "description": "User security roles"
    },
    "/content_items/{itemId}": {
      "schema": { "$ref": "#/entities/ContentItem" },
      "description": "CMS content documents"
    },
    "/contact_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Public contact form entries"
    },
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/Application" },
      "description": "Job and training submissions"
    },
    "/site_settings/{key}": {
      "schema": { "$ref": "#/entities/SiteSetting" },
      "description": "Organization global configuration"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "System audit logs"
    }
  }
}
